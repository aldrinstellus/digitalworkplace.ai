# ============================================
# dIQ - INTRANET IQ
# ============================================
# App: AI-Powered Internal Knowledge Network
# Port: 3001
# BasePath: /diq
# Version: 2.2.0
# Copy to: /apps/intranet-iq/.env.local
# ============================================

# ============================================
# CLERK AUTHENTICATION
# ============================================
# Shared auth with main app (www.digitalworkplace.ai)
CLERK_SECRET_KEY="<YOUR_CLERK_SECRET_KEY>"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="<YOUR_CLERK_PUBLISHABLE_KEY>"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="http://localhost:3000/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="http://localhost:3000/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/diq/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/diq/dashboard"

# Main app URL for shared authentication
NEXT_PUBLIC_MAIN_APP_URL="http://localhost:3000"

# ============================================
# SUPABASE DATABASE
# ============================================
# Project: fhtempgkltrazrgbedrh
# Schema: diq (project-specific) + public (shared)
# Tables: 45+ with full RLS policies
# Region: us-east-1
NEXT_PUBLIC_SUPABASE_URL="https://fhtempgkltrazrgbedrh.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<YOUR_SUPABASE_ANON_KEY>"
SUPABASE_PUBLISHABLE_KEY="<YOUR_SUPABASE_PUBLISHABLE_KEY>"

# ============================================
# ELASTICSEARCH (Local Docker)
# ============================================
# Start: docker compose -f docker-compose.elasticsearch.yml up -d
# Admin: http://localhost:5601 (Kibana)
ELASTICSEARCH_URL="http://localhost:9200"
ELASTICSEARCH_INDEX="diq-content"

# ============================================
# ANTHROPIC API (Claude AI - Primary LLM)
# ============================================
# Model: claude-3-5-sonnet-20241022
# Used for: AI Chat, RAG, Function Calling
ANTHROPIC_API_KEY="<YOUR_ANTHROPIC_API_KEY>"

# ============================================
# OPENAI API (Embeddings)
# ============================================
# Model: text-embedding-3-small
# Dimensions: 1536
# Used for: Semantic search, vector embeddings
OPENAI_API_KEY="<YOUR_OPENAI_API_KEY>"

# ============================================
# PRODUCTION URLs
# ============================================
# Local: http://localhost:3001/diq/dashboard
# Production: https://diq.digitalworkplace.ai/diq/dashboard
# Vercel: https://intranet-iq.vercel.app/diq/dashboard

# ============================================
# WHERE TO GET KEYS
# ============================================
# CLERK_*              -> https://dashboard.clerk.com → API Keys
# SUPABASE_*           -> Supabase Dashboard → Project Settings → API
# ANTHROPIC_API_KEY    -> https://console.anthropic.com/settings/keys
# OPENAI_API_KEY       -> https://platform.openai.com/api-keys
