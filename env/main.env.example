# ============================================
# DIGITAL WORKPLACE AI - MAIN DASHBOARD
# ============================================
# App: Main Dashboard (www.digitalworkplace.ai)
# Port: 3000
# Copy to: /apps/main/.env.local
# ============================================

# ============================================
# CLERK AUTHENTICATION
# ============================================
# Dashboard: https://dashboard.clerk.com
# App: digitalworkplace.ai
CLERK_SECRET_KEY="<YOUR_CLERK_SECRET_KEY>"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="<YOUR_CLERK_PUBLISHABLE_KEY>"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Force redirect URLs (bypasses organization tasks screen)
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL="/dashboard"

# ============================================
# SUPABASE DATABASE
# ============================================
# Project: fhtempgkltrazrgbedrh
# Schema: public (shared tables)
# Region: us-east-1
NEXT_PUBLIC_SUPABASE_URL="https://fhtempgkltrazrgbedrh.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<YOUR_SUPABASE_ANON_KEY>"
SUPABASE_PUBLISHABLE_KEY="<YOUR_SUPABASE_PUBLISHABLE_KEY>"

# ============================================
# OPENAI API (Optional - for future features)
# ============================================
OPENAI_API_KEY="<YOUR_OPENAI_API_KEY>"

# ============================================
# PRODUCTION URLs
# ============================================
# Main: https://www.digitalworkplace.ai
# Vercel: https://digitalworkplace-ai.vercel.app

# ============================================
# WHERE TO GET KEYS
# ============================================
# CLERK_*              -> https://dashboard.clerk.com → API Keys
# SUPABASE_*           -> Supabase Dashboard → Project Settings → API
# OPENAI_API_KEY       -> https://platform.openai.com/api-keys
