# ============================================
# dSQ - SUPPORT IQ
# ============================================
# App: AI-Enhanced Customer Support
# Port: 3003
# BasePath: /dsq
# Version: 1.2.7
# Copy to: /apps/support-iq/.env.local
# ============================================

# ============================================
# DEMO MODE (CRITICAL)
# ============================================
# Enables pre-configured widget responses for demos
# Set to false for production with real data
NEXT_PUBLIC_DEMO_MODE=true

# ============================================
# NEXTAUTH.JS AUTHENTICATION
# ============================================
# Generate new secret: openssl rand -base64 32
AUTH_SECRET=<GENERATE_WITH_openssl_rand_-base64_32>

# ============================================
# SUPABASE DATABASE
# ============================================
# Project: fhtempgkltrazrgbedrh
# Schema: dsq (project-specific)
# Tables: 15+ tables, 356 knowledge items
# Region: us-east-1
NEXT_PUBLIC_SUPABASE_URL="https://fhtempgkltrazrgbedrh.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<YOUR_SUPABASE_ANON_KEY>"
SUPABASE_PUBLISHABLE_KEY="<YOUR_SUPABASE_PUBLISHABLE_KEY>"

# ============================================
# ANTHROPIC API (Claude AI - Primary LLM)
# ============================================
# Model: claude-3-5-sonnet-20241022
# Used for: AI chat, widget responses
ANTHROPIC_API_KEY="<YOUR_ANTHROPIC_API_KEY>"

# ============================================
# OPENAI API (Embeddings)
# ============================================
# Model: text-embedding-3-small
# Dimensions: 1536
# Used for: Semantic search, query matching
OPENAI_API_KEY="<YOUR_OPENAI_API_KEY>"

# ============================================
# DATABASE (Prisma - Optional)
# ============================================
# Get password from Supabase Dashboard > Settings > Database
# DATABASE_URL="postgresql://postgres.fhtempgkltrazrgbedrh:[YOUR_DB_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ============================================
# WEBSOCKET (Optional - Real-time features)
# ============================================
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# ============================================
# PRODUCTION URLs
# ============================================
# Local: http://localhost:3003/dsq/demo/atc-executive
# Production: https://dsq.digitalworkplace.ai/dsq/demo/atc-executive
# All 10 personas available at /dsq/demo/{persona-slug}

# ============================================
# DEMO PERSONAS (10 Total)
# ============================================
# ATC Mode:
#   - /dsq/demo/atc-executive
#   - /dsq/demo/atc-manager
#   - /dsq/demo/atc-support
#   - /dsq/demo/atc-csm
# Government Mode:
#   - /dsq/demo/cor
#   - /dsq/demo/program-manager
#   - /dsq/demo/stakeholder-lead
# Project Mode:
#   - /dsq/demo/project-manager
#   - /dsq/demo/service-team-lead
#   - /dsq/demo/service-team-member

# ============================================
# WHERE TO GET KEYS
# ============================================
# AUTH_SECRET          -> Generate: openssl rand -base64 32
# SUPABASE_*           -> Supabase Dashboard → Project Settings → API
# ANTHROPIC_API_KEY    -> https://console.anthropic.com/settings/keys
# OPENAI_API_KEY       -> https://platform.openai.com/api-keys
